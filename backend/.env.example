# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=

# One model does everything. The evaluation confirmed a stronger model did
# not improve routing -- the failure there was a prompt problem, not a
# capability one. Keep all three the same unless a measurement says otherwise.
MODEL_DEFAULT=google/gemini-2.5-flash-lite
MODEL_REASONING=google/gemini-2.5-flash-lite
MODEL_VISION=google/gemini-2.5-flash-lite

# --- Search (https://serpapi.com) ---
# Free tier is 250 searches/month and one thorough run can burn five.
# Results are cached by part number for that reason.
SERPAPI_KEY=

# --- Email, RFQ fallback only ---
# Gmail needs an App Password (16 chars, requires 2FA on the account).
# A normal account password has been rejected by Google since 2022.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# --- Import destination, drives landed cost ---
DESTINATION_COUNTRY=UZ
VAT_RATE=0.12
DEFAULT_DUTY_RATE=0.20
BASE_CURRENCY=USD

# --- Deployment ---
# Comma-separated origins allowed to call this API. In production set it to
# the Vercel URL. "*" is fine only while nothing here is authenticated.
ALLOWED_ORIGINS=*
